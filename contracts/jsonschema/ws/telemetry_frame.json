{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS TELEMETRY_FRAME Message",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "TELEMETRY_FRAME" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vitals", "environment", "subsystems", "ai_ready"],
          "properties": {
            "vitals": { "$ref": "../_defs.json#/$defs/vitals_data" },
            "environment": { "$ref": "../_defs.json#/$defs/environment_data" },
            "subsystems": { "type": "array", "items": { "$ref": "../_defs.json#/$defs/subsystem_state" } },
            "ai_ready": { "type": "boolean" }
          }
        }
      }
    }
  ]
}