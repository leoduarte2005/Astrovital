{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS CHAT_REPLY Message",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "CHAT_REPLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidence", "countermeasures", "source_ids", "escalation", "disclaimer"],
          "properties": {
            "text": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } },
            "countermeasures": { "type": "array", "items": { "type": "string" } },
            "source_ids": { "type": "array", "items": { "type": "string" } },
            "escalation": { "$ref": "../../enums/escalation.json" },
            "disclaimer": { "type": "string" },
            "differentials": { "type": "array", "items": { "type": "string" } },
            "disambiguation_question": { "type": "string" },
            "actions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  ]
}